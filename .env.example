# Copy this file to .env and fill in real values
WHATSAPP_HEADLESS=false
WHATSAPP_KEEP_OPEN=true
WHATSAPP_TIMEOUT_MS=15000
WHATSAPP_RECORD_WAIT_TIMEOUT_MS=300000
WHATSAPP_SEND_WAIT_TIMEOUT_MS=20000
WHATSAPP_URL=https://web.whatsapp.com/
WHATSAPP_PLAYBACK_SCRIPT=src/util/scripts/virtual_microphone/play_mic.sh
# Optional: override browser profile path
# WHATSAPP_PROFILE_DIR=.playwright_whatsapp_profile
